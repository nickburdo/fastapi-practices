# Optional. By default the database is books.db in the project root (absolute path).
# Use an absolute path when overriding: a relative one depends on the working directory.
# DATABASE_URL=sqlite+aiosqlite:///C:/absolute/path/to/books.db
# Required. Secret key for signing JWT tokens, at least 32 characters.
# Generate one with: uv run python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# Optional. Folder for uploaded files (default: uploads/ in the project root), absolute path.
# UPLOAD_DIR=C:/absolute/path/to/uploads
# Optional. Upload limits: max size of one file in bytes (default 10 MB) and max files per request (default 10).
# MAX_UPLOAD_SIZE=10485760
# MAX_FILES_PER_UPLOAD=10
